# MySQL
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Backend datasource (must match the MySQL values above)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/portfolio
SPRING_DATASOURCE_USERNAME=portfolio
SPRING_DATASOURCE_PASSWORD=changeme

# External API keys (free tiers — leave empty to run with degraded/no chart data)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# Backend CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend chatbot (Groq) — build-time arg, baked into the frontend bundle
VITE_GROQ_API_KEY=

# MySQL
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Backend datasource (must match the MySQL values above)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/portfolio
SPRING_DATASOURCE_USERNAME=portfolio
SPRING_DATASOURCE_PASSWORD=changeme

# External API keys (free tiers — leave empty to run with degraded/no chart data)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

# Host ports (change if these clash with other services on the machine)
DB_PORT=33061
BACKEND_PORT=18080
FRONTEND_PORT=18173

# Backend CORS — comma-separated origins allowed to call the API directly.
# Must include the URL the frontend is actually served from, e.g. when
# running on a remote VM/EC2 box: http://<host-ip>:${FRONTEND_PORT}
CORS_ALLOWED_ORIGINS=http://localhost:18173

# Frontend chatbot (Groq) — build-time arg, baked into the frontend bundle
VITE_GROQ_API_KEY=
